# EduEats student app settings.
# Copy this file to ".env.production" (or ".env.local") and fill it in.
# These values end up inside the built app, so never put passwords or keys here.

# Address of the Spring Boot backend when the app is hosted online.
# Leave it empty (or delete the line) for local work with "npm run dev".
# No slash at the end.
VITE_API_URL=
