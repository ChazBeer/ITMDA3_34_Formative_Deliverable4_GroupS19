# Local Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cafeteriadb
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cafeteriadb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Africa/Johannesburg

# JWT Config
JWT_SECRET=your_generated_jwt_secret_here

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Application Base URL
APP_BASE_URL=http://localhost:8080

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here